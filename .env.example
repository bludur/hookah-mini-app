APP_ENV=development
BOT_TOKEN=
LLM_API_KEY=
LLM_API_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
# Free deployment: LLM_MODEL=openrouter/free and LLM_FREE_ONLY=true.
LLM_FREE_ONLY=false
# Leave DATABASE_URL unset to use hookah_app.db in the repository root.
# Production: postgresql+asyncpg://user:password@host/database
# DATABASE_URL=
# Production requires Redis shared by the API and bot, with persistence and no eviction.
REDIS_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TELEGRAM_AUTH_MAX_AGE=3600
LLM_TIMEOUT_SECONDS=40
GENERATION_HOURLY_LIMIT=10
GENERATION_DAILY_LIMIT=30
GENERATION_GLOBAL_DAILY_LIMIT=1000
GENERATION_CONCURRENCY=4
MAX_COLLECTION_SIZE=200
